#!name=七鲜去开屏广告
#!desc=将七鲜开屏广告返回中所有层级的展示时间改为已过期时间，避免开屏广告展示。
#!author=KinJ
#!homepage=https://github.com/KinJ/Net-Config
#!category=去广告
#!date=2026-09-04 22:15:00

[Body Rewrite]
# 将响应中所有层级的 beginTime/endTime 改为已过期时间
http-response-jq ^https:\/\/color\.7fresh\.com\/api\?(?:[^&]+&)*functionId=start_screen_7fresh_query(?:&|$) '((.. | objects | select(has("beginTime")) | .beginTime) = "2026-01-01 00:00:00") | ((.. | objects | select(has("endTime")) | .endTime) = "2026-01-02 00:00:00")'

[MITM]
hostname = %APPEND% color.7fresh.com
