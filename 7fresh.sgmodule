#!name=七鲜去开屏广告
#!desc=删除七鲜开屏广告接口返回中的 floors。
#!author=KinJ
#!icon=https://m.7fresh.com/static/icon/logo.png
#!homepage=https://github.com/KinJ/Net-Config
#!category=去广告
#!date=2026-09-04 23:50:00

[Body Rewrite]
# 删除开屏广告楼层
http-response-jq ^https:\/\/color\.7fresh\.com\/api\?(?:[^&]+&)*functionId=start_screen_7fresh_query(?:&|$) '.data.floors = []'

[MITM]
hostname = %APPEND% color.7fresh.com,120.52.30.23,36.143.249.15,106.39.169.238
